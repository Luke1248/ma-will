{
  "@context": "https://schema.org",
  "@type": "Attorney",
  "@id": "{{WEBSITE_URL}}/#attorney",
  "name": "{{FIRM_NAME}}",
  "url": "{{WEBSITE_URL}}",
  "image": "{{WEBSITE_URL}}/images/headshot.jpg",
  "logo": "{{WEBSITE_URL}}/images/logo.png",
  "description": "{{ONE_SENTENCE_DESCRIPTION — mirror the directory headline}}",
  "telephone": "{{PHONE_E164 — e.g. +1-617-555-0100}}",
  "email": "{{EMAIL}}",
  "priceRange": "{{$$ or omit this property entirely}}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{STREET_ADDRESS}}",
    "addressLocality": "{{CITY}}",
    "addressRegion": "MA",
    "postalCode": "{{ZIP}}",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "{{LATITUDE}}",
    "longitude": "{{LONGITUDE}}"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "{{09:00}}",
      "closes": "{{17:00}}"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "{{CITY}}" },
    { "@type": "State", "name": "Massachusetts" },
    { "@type": "AdministrativeArea", "name": "{{COUNTY}} County, Massachusetts" }
  ],
  "knowsLanguage": ["en", "{{OTHER_LANGUAGE_CODE — remove if none}}"],
  "founder": {
    "@type": "Person",
    "@id": "{{WEBSITE_URL}}/#person",
    "name": "{{FULL_LEGAL_NAME}}",
    "jobTitle": "Attorney",
    "image": "{{WEBSITE_URL}}/images/headshot.jpg",
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "{{LAW_SCHOOL}}"
    },
    "memberOf": [
      { "@type": "Organization", "name": "{{BAR_ASSOCIATION_1}}" },
      { "@type": "Organization", "name": "{{BAR_ASSOCIATION_2}}" }
    ],
    "sameAs": [
      "{{AVVO_PROFILE_URL}}",
      "{{JUSTIA_PROFILE_URL}}",
      "{{LINKEDIN_URL}}",
      "{{SUPER_LAWYERS_URL — remove unless actually selected}}"
    ]
  },
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "license",
    "recognizedBy": {
      "@type": "GovernmentOrganization",
      "name": "Supreme Judicial Court of Massachusetts, Board of Bar Overseers"
    },
    "identifier": "{{BBO_NUMBER}}"
  },
  "makesOffer": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Appellate Litigation",
        "description": "{{SERVICE_DESCRIPTION}}",
        "serviceType": "Appellate Litigation",
        "areaServed": { "@type": "State", "name": "Massachusetts" }
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Professional Ethics",
        "description": "{{SERVICE_DESCRIPTION}}",
        "serviceType": "Professional Ethics",
        "areaServed": { "@type": "State", "name": "Massachusetts" }
      }
    }
  ]
}
